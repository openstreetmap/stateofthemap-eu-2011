# Ignore git metadata folder
.git/
.github/

# Ignore metadata generated by Jekyll
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata

# Ignore folders generated by Bundler
.bundle/
vendor/

# Ignore docker related files
Dockerfile*
docker-compose.*
.dockerignore
.gitignore

# Ignore import tooling, raw Archive.org cache and provenance data
scripts/
.cache/
archive-manifest.json
README.md
.editorconfig
